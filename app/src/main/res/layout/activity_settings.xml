<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Wake word"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/wakeWordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Extra wake words (comma-separated, e.g. sam)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/wakeAliasesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/applyWakeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Apply wake words" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mic sensitivity"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Boosts the microphone signal before it reaches the recognizer - turn this up if you have to shout or repeat yourself for the wake word to catch, especially on a car head unit's built-in mic. Takes effect immediately, no restart needed."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/micSensitivitySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="90" />
            <TextView
                android:id="@+id/micSensitivityLabel"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.0x" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Music folders"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No music shows up until you add a folder below (or turn on the whole-device option) - nothing is scanned automatically."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/folderListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/addFolderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add Music Folder" />

        <CheckBox
            android:id="@+id/wholeDeviceCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Also include the whole device's music library" />

        <Button
            android:id="@+id/rescanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rescan Library" />

        <TextView
            android:id="@+id/scanStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Theme"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/themeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dark" />
            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Plain / Light" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Skip (start every song this far in)"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Applies to every song, current and future - not the same as a song's own trim points below, and not the same as saying &quot;skip 30 seconds&quot; alone (that only jumps the CURRENT song, once). Same as the voice command &quot;skip all songs 30 seconds&quot;."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/skipSecondsSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="60" />
            <TextView
                android:id="@+id/skipSecondsLabel"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0s" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Skip to vocals (beta)"
            android:textStyle="bold" />
        <CheckBox
            android:id="@+id/autoSkipIntroCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatically skip the instrumental intro of every song" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is a loudness-based GUESS at where the intro ends, not real vocal detection (true vocal separation needs a heavy ML model this app doesn't run). It looks for the point a song's energy jumps up and stays up compared to its own quiet opening - works reasonably on a typical instrumental-intro-then-full-band song, and will guess wrong on others. Say &quot;skip to vocals&quot; (or &quot;skip intro&quot;) any time for a one-off manual jump on whatever's playing, regardless of this setting."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Startup"
            android:textStyle="bold" />
        <CheckBox
            android:id="@+id/autoStartCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-open when the car/tablet turns on" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumes playback automatically from wherever it left off - no taps needed. On some tablets (especially budget/car-head-unit Android boxes), you may also need to enable &quot;autostart&quot; or &quot;background activity&quot; for this app in the device's own system settings - that's a manufacturer restriction this app can't bypass on its own."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Last error/crash"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/crashLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary"
            android:text="None recorded." />
        <Button
            android:id="@+id/clearCrashLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Clear" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:text="Voice commands: play / pause / next / previous / status / play &lt;song name&gt; / skip 30 seconds (current song only, once) / skip all songs 30 seconds (global, same as the Skip setting above) / trim forty thirty / a number 1-5 for rating (for MP3/FLAC, also written into the file's own tag - visible in other players too) / skip to vocals (or &quot;skip intro&quot; - one-off jump past this song's guessed intro, see Skip to vocals above)." />

    </LinearLayout>
</ScrollView>
